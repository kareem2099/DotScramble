/* ═══════════════════════════════════════════════════════════════════════════
   DotScramble — application stylesheet (single source of truth)

   Tokens are filled in by ThemeManager from the active theme in themes.json:
     {key}        theme color            e.g. {accent_cyan}
     {key@NN}     color at NN % opacity  e.g. {accent_cyan@15}
     {on:key}     readable text color on top of that color

   Widgets never set colors or fonts in Python. They expose hooks instead:
     objectName   for unique pieces of the shell      (#Toolbar, #Sidebar …)
     variant      for button flavours                 [variant="primary"]
     role         for text styles                     [role="caption"]
   ═══════════════════════════════════════════════════════════════════════════ */


/* ── 1. Base ──────────────────────────────────────────────────────────────── */

QWidget {
    background-color: {bg_dark};
    color: {text_primary};
    font-family: "Segoe UI", "Inter", "Noto Sans", "Noto Sans Arabic", "Cairo", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: {bg_dark};
}

QFrame {
    border: none;
}

QLabel {
    background-color: transparent;
}

QToolTip {
    background-color: {bg_medium};
    color: {text_primary};
    border: 1px solid {border_color};
    border-radius: 6px;
    padding: 6px 8px;
}


/* ── 2. Menus & status bar ────────────────────────────────────────────────── */

QMenuBar {
    background-color: {bg_medium};
    border-bottom: 1px solid {border_color};
    padding: 2px 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: {hover_color};
    color: {accent_cyan};
}

QMenu {
    background-color: {bg_medium};
    border: 1px solid {border_color};
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: {hover_color};
    color: {accent_cyan};
}

QMenu::item:disabled {
    color: {text_disabled};
}

QMenu::separator {
    height: 1px;
    background-color: {border_color};
    margin: 4px 8px;
}

QStatusBar {
    background-color: {bg_medium};
    border-top: 1px solid {border_color};
    color: {text_secondary};
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: {text_secondary};
    padding: 0 8px;
}


/* ── 3. Scrollbars & splitter ─────────────────────────────────────────────── */

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: {border_color};
    min-height: 28px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: {text_disabled};
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: {border_color};
    min-width: 28px;
    border-radius: 3px;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    border: none;
    background: none;
    width: 0;
    height: 0;
}

QSplitter::handle {
    background-color: {border_color};
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:hover {
    background-color: {accent_cyan};
}


/* ── 4. Buttons ───────────────────────────────────────────────────────────── */

QPushButton {
    background-color: {bg_light};
    border: 1px solid {border_color};
    border-radius: 6px;
    padding: 7px 14px;
    color: {text_primary};
    font-weight: 600;
}

QPushButton:hover {
    border-color: {accent_cyan};
    color: {accent_cyan};
}

QPushButton:pressed {
    background-color: {selection_bg};
}

QPushButton:disabled {
    background-color: transparent;
    border-color: {border_color};
    color: {text_disabled};
}

QPushButton:focus {
    outline: none;
}

/* Primary — exactly one per screen (Apply effect, dialog confirm) */
QPushButton[variant="primary"], QPushButton#primary_action {
    background-color: {accent_cyan};
    border: 1px solid {accent_cyan};
    color: {on:accent_cyan};
    font-weight: 700;
}

QPushButton[variant="primary"]:hover, QPushButton#primary_action:hover {
    background-color: {accent_cyan@85};
    color: {on:accent_cyan};
}

QPushButton[variant="primary"]:disabled, QPushButton#primary_action:disabled {
    background-color: {accent_cyan@25};
    border-color: transparent;
    color: {text_disabled};
}

QPushButton[variant="primary"][size="large"] {
    padding: 11px 16px;
    font-size: 14px;
    border-radius: 8px;
}

/* Ghost — secondary actions that should not compete with primary */
QPushButton[variant="ghost"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: {text_secondary};
    font-weight: 600;
}

QPushButton[variant="ghost"]:hover {
    background-color: {hover_color};
    color: {text_primary};
}

QPushButton[variant="ghost"]:disabled {
    color: {text_disabled};
}

/* Danger — destructive actions */
QPushButton[variant="danger"], QPushButton#del_preset_btn, QPushButton#strip_all_btn {
    color: {accent_red};
    border-color: {accent_red@60};
    background-color: transparent;
}

QPushButton[variant="danger"]:hover, QPushButton#del_preset_btn:hover, QPushButton#strip_all_btn:hover {
    background-color: {accent_red@12};
}

/* Upgrade — the only orange thing in the app */
QPushButton[variant="upgrade"] {
    background-color: {accent_orange@15};
    border: 1px solid {accent_orange@60};
    color: {accent_orange};
    padding: 4px 12px;
    border-radius: 13px;
    font-weight: 700;
}

QPushButton[variant="upgrade"]:hover {
    background-color: {accent_orange@25};
    color: {accent_orange};
}

/* Link — inline text button */
QPushButton[variant="link"] {
    background: transparent;
    border: none;
    padding: 0;
    color: {accent_cyan};
    font-weight: 600;
    text-align: left;
}

QPushButton[variant="link"]:hover {
    text-decoration: underline;
}

/* Status bar "restart to update" */
QPushButton#update_btn {
    background-color: {accent_green};
    border: none;
    color: {on:accent_green};
    padding: 3px 10px;
    font-size: 12px;
}


/* ── 5. Inputs ────────────────────────────────────────────────────────────── */

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: {bg_dark};
    border: 1px solid {border_color};
    border-radius: 6px;
    padding: 6px 8px;
    color: {text_primary};
    selection-background-color: {selection_bg};
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: {accent_cyan};
}

QSlider {
    background: transparent;
    min-height: 22px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: {border_color};
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: {accent_cyan};
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: {accent_cyan};
    border: 3px solid {bg_medium};
    width: 12px;
    height: 12px;
    margin: -7px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    border-color: {accent_cyan@40};
}

QSlider::sub-page:horizontal:disabled, QSlider::handle:horizontal:disabled {
    background: {text_disabled};
}

QRadioButton, QCheckBox {
    spacing: 8px;
    background-color: transparent;
    color: {text_primary};
}

QRadioButton:disabled, QCheckBox:disabled {
    color: {text_disabled};
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 14px;
    height: 14px;
}

QRadioButton::indicator {
    border: 1px solid {text_disabled};
    background-color: transparent;
    border-radius: 8px;
}

QRadioButton::indicator:checked {
    border: 4px solid {accent_cyan};
    width: 8px;
    height: 8px;
}

QCheckBox::indicator {
    border: 1px solid {text_disabled};
    background-color: transparent;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    border-color: {accent_cyan};
    background-color: {accent_cyan};
}

QProgressBar {
    background-color: {bg_light};
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: {text_secondary};
}

QProgressBar::chunk {
    background-color: {accent_cyan};
    border-radius: 4px;
}


/* ── 6. Tables, lists, group boxes (dialogs) ──────────────────────────────── */

QTableWidget, QListWidget {
    background-color: {bg_medium};
    gridline-color: {border_color};
    border: 1px solid {border_color};
    border-radius: 6px;
    color: {text_primary};
}

QHeaderView::section {
    background-color: {bg_light};
    color: {text_primary};
    padding: 6px;
    border: none;
    border-bottom: 1px solid {border_color};
    font-weight: 600;
}

QGroupBox {
    border: 1px solid {border_color};
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: {accent_cyan};
}


/* ── 7. Text roles ────────────────────────────────────────────────────────── */

QLabel[role="caption"] {
    color: {text_secondary};
    font-size: 12px;
}

QLabel[role="hint"] {
    color: {text_secondary};
    font-size: 12px;
    background-color: {bg_light};
    border-radius: 6px;
    padding: 8px 10px;
}

QLabel[role="heading"] {
    color: {text_secondary};
    font-size: 11px;
    font-weight: 700;
    padding-top: 6px;
}

QLabel[role="field-label"] {
    color: {text_primary};
    font-weight: 600;
}

QLabel[role="field-value"] {
    color: {text_secondary};
}

QLabel[role="value-pill"] {
    color: {accent_cyan};
    background-color: {accent_cyan@12};
    border-radius: 9px;
    padding: 1px 8px;
    font-size: 12px;
    font-weight: 700;
}

QFrame#separator, QFrame#exif_divider {
    background-color: {border_color};
    max-height: 1px;
}


/* ── 8. App shell: toolbar ────────────────────────────────────────────────── */

QFrame#Toolbar {
    background-color: {bg_medium};
    border-bottom: 1px solid {border_color};
}

QLabel#BrandLabel {
    color: {accent_cyan};
    font-size: 15px;
    font-weight: 800;
    padding: 0 6px;
}

QFrame#ToolbarSeparator {
    background-color: {border_color};
    min-width: 1px;
    max-width: 1px;
    margin: 8px 4px;
}

QFrame#Toolbar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 8px;
    color: {text_primary};
    font-weight: 600;
}

QFrame#Toolbar QToolButton:hover {
    background-color: {hover_color};
}

QFrame#Toolbar QToolButton:pressed {
    background-color: {selection_bg};
}

QFrame#Toolbar QToolButton:checked {
    background-color: {accent_cyan@15};
    border-color: {accent_cyan@45};
    color: {accent_cyan};
}

QFrame#Toolbar QToolButton:disabled {
    color: {text_disabled};
}

QFrame#Toolbar QToolButton#ZoomLabel {
    min-width: 46px;
    color: {text_secondary};
    font-size: 12px;
}

QLabel#ProPill {
    color: {accent_green};
    background-color: {accent_green@15};
    border: 1px solid {accent_green@50};
    border-radius: 11px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 800;
}


/* ── 9. App shell: sidebar ────────────────────────────────────────────────── */

QFrame#Sidebar {
    background-color: {bg_medium};
}

QWidget#SidebarContent {
    background-color: {bg_medium};
}

QFrame#SidebarFooter {
    background-color: {bg_medium};
    border-top: 1px solid {border_color};
}

/* Collapsible section */
QFrame#Section {
    background-color: transparent;
    border-bottom: 1px solid {border_color};
}

QFrame#SectionHeader {
    background-color: transparent;
    border-radius: 6px;
}

QFrame#SectionHeader:hover {
    background-color: {hover_color};
}

QLabel#SectionStep {
    background-color: {accent_cyan@15};
    color: {accent_cyan};
    border-radius: 10px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    font-size: 11px;
    font-weight: 800;
    qproperty-alignment: AlignCenter;
}

QLabel#SectionTitle {
    font-size: 13px;
    font-weight: 700;
}

QLabel#SectionSummary {
    color: {text_secondary};
    font-size: 12px;
}

QWidget#SectionBody {
    background-color: transparent;
}

/* Option tiles (effects) & chips (detection modes) */
QToolButton[variant="tile"], QPushButton[variant="chip"] {
    background-color: transparent;
    border: 1px solid {border_color};
    border-radius: 8px;
    color: {text_secondary};
    font-size: 12px;
    font-weight: 600;
}

QToolButton[variant="tile"] {
    padding: 8px 2px 6px 2px;
}

QPushButton[variant="chip"] {
    padding: 7px 10px;
    text-align: left;
}

QToolButton[variant="tile"]:hover, QPushButton[variant="chip"]:hover {
    background-color: {hover_color};
    color: {text_primary};
}

QToolButton[variant="tile"]:checked, QPushButton[variant="chip"]:checked {
    background-color: {accent_cyan@14};
    border-color: {accent_cyan};
    color: {accent_cyan};
}

QToolButton[variant="tile"]:disabled, QPushButton[variant="chip"]:disabled {
    color: {text_disabled};
    border-color: {border_color@50};
}

QToolButton[variant="tile"][locked="true"], QPushButton[variant="chip"][locked="true"] {
    color: {text_disabled};
    border-style: dashed;
}

/* Segmented control (metadata mode) */
QPushButton[variant="segment"] {
    background-color: {bg_dark};
    border: 1px solid {border_color};
    border-radius: 0;
    padding: 6px 4px;
    color: {text_secondary};
    font-size: 12px;
}

QPushButton[variant="segment"][position="first"] {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

QPushButton[variant="segment"][position="last"] {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QPushButton[variant="segment"]:hover {
    color: {text_primary};
}

QPushButton[variant="segment"]:checked {
    background-color: {accent_cyan@15};
    border-color: {accent_cyan};
    color: {accent_cyan};
}

QPushButton[variant="segment"]:disabled {
    color: {text_disabled};
}

QPushButton[variant="segment"][locked="true"] {
    color: {text_disabled};
}


/* ── 10. Canvas (colors read by ImageCanvas.paintEvent) ───────────────────── */

QWidget#ImageCanvas {
    qproperty-backgroundColor: {canvas_bg};
    qproperty-accentColor: {accent_cyan};
    qproperty-dangerColor: {accent_red};
    qproperty-mutedColor: {text_disabled};
    qproperty-textColor: {text_secondary};
    qproperty-surfaceColor: {bg_medium};
}


/* ── 11. Image picker (core/image_picker.py) ──────────────────────────────── */

/* Frameless, translucent dialog: only the rounded root paints */
QDialog#ImagePicker {
    background: transparent;
}

QFrame#PickerRoot {
    background-color: {bg_medium};
    border: 1px solid {border_color};
    border-radius: 12px;
}

QFrame#PickerTitleBar {
    background-color: transparent;
}

QLabel#PickerTitle {
    color: {accent_cyan};
    font-size: 15px;
    font-weight: 800;
}

QLineEdit#PickerSearch {
    min-width: 220px;
    max-width: 220px;
}

QPushButton#PickerClose {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}

QPushButton#PickerClose:hover {
    background-color: {accent_red@20};
}

QFrame#PickerSidebar {
    background-color: transparent;
}

QFrame#PickerDivider {
    background-color: {border_color};
}

QPushButton#PickerPlace {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0 10px;
    color: {text_secondary};
    font-weight: 500;
    text-align: left;
}

QPushButton#PickerPlace:hover {
    background-color: {hover_color};
    color: {text_primary};
}

QPushButton#PickerPlace[active="true"] {
    background-color: {accent_cyan@14};
    color: {accent_cyan};
    font-weight: 700;
}

QWidget#PickerCenter, QWidget#PickerGrid {
    background-color: {bg_dark};
}

QFrame#PickerBreadcrumbs {
    background-color: {bg_dark};
    border-bottom: 1px solid {border_color};
}

QPushButton#PickerCrumb {
    background: transparent;
    border: none;
    padding: 2px 4px;
    color: {text_secondary};
    font-size: 12px;
    font-weight: 500;
}

QPushButton#PickerCrumb:hover {
    color: {text_primary};
}

QPushButton#PickerCrumb[current="true"] {
    color: {accent_cyan};
    font-weight: 700;
}

QWidget#PickerTile {
    qproperty-tileColor: {bg_light};
    qproperty-selectedColor: {accent_cyan@14};
    qproperty-accentColor: {accent_cyan};
    qproperty-borderColor: {border_color};
    qproperty-slotColor: {bg_medium};
    qproperty-textColor: {text_primary};
}

QFrame#PickerPreview {
    background-color: {bg_medium};
    border-left: 1px solid {border_color};
}

QFrame#PickerPreview[rtl="true"] {
    border-left: none;
    border-right: 1px solid {border_color};
}

QLabel#PickerPreviewThumb {
    background-color: {bg_dark};
    border: 1px solid {border_color};
    border-radius: 8px;
}

QFrame#PickerFooter {
    background-color: transparent;
    border-top: 1px solid {border_color};
}

QLabel#PickerPath {
    color: {text_secondary};
    font-family: "JetBrains Mono", "DejaVu Sans Mono", "Consolas", monospace;
    font-size: 12px;
}


/* ── 12. Dialogs ──────────────────────────────────────────────────────────── */

#DialogHeader {
    background-color: {bg_medium};
    border-bottom: 1px solid {border_color};
}

#DialogTitle, #FileCountLabel, #TimeLabel {
    color: {accent_cyan};
}

#SuccessLabel {
    color: {accent_green};
}

#FailedLabel {
    color: {accent_red};
}

#plan_lbl {
    color: {accent_orange};
    font-weight: 700;
    font-style: italic;
}

#preset_lbl {
    color: {text_secondary};
}

#card_frame {
    background-color: {bg_light};
    border: 1px solid {border_color};
    border-radius: 8px;
}

/* The custom-value row inside a card shows the card, not the window background */
QWidget#card_row {
    background-color: transparent;
}

#card_val_lbl_active, #card_val_lbl_inactive {
    background-color: {bg_dark};
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 11px;
}

#card_val_lbl_active {
    color: {accent_cyan};
}

#card_val_lbl_inactive {
    color: {text_disabled};
}

#btn_frame {
    background-color: {bg_medium};
    border-top: 1px solid {border_color};
}

#legend_keep, #legend_strip, #legend_spoof, #legend_custom {
    font-weight: 700;
    border-radius: 4px;
    padding: 3px 8px;
}

#legend_keep   { background-color: {accent_green};  color: {on:accent_green}; }
#legend_strip  { background-color: {accent_red};    color: {on:accent_red}; }
#legend_spoof  { background-color: {accent_cyan};   color: {on:accent_cyan}; }
#legend_custom { background-color: {accent_orange}; color: {on:accent_orange}; }

/* Metadata customizer — action pills (Keep / Strip / Spoof / Custom) */
QRadioButton[variant="action"] {
    background-color: {bg_dark};
    border: 1px solid {border_color};
    border-radius: 6px;
    padding: 4px 10px;
    color: {text_secondary};
    font-size: 12px;
}

QRadioButton[variant="action"]::indicator {
    width: 0;
    height: 0;
    border: none;
}

QRadioButton[variant="action"]:hover {
    color: {text_primary};
}

QRadioButton[variant="action"][action="keep"]:checked   { background-color: {accent_green@18};  border-color: {accent_green};  color: {accent_green}; }
QRadioButton[variant="action"][action="strip"]:checked  { background-color: {accent_red@18};    border-color: {accent_red};    color: {accent_red}; }
QRadioButton[variant="action"][action="spoof"]:checked  { background-color: {accent_cyan@18};   border-color: {accent_cyan};   color: {accent_cyan}; }
QRadioButton[variant="action"][action="custom"]:checked { background-color: {accent_orange@18}; border-color: {accent_orange}; color: {accent_orange}; }

/* Metadata save report */
QFrame#ReportBanner {
    border-radius: 8px;
    border: 1px solid {border_color};
}

QFrame#ReportBanner[action="keep"]  { background-color: {accent_green@15}; border-color: {accent_green@60}; }
QFrame#ReportBanner[action="strip"] { background-color: {accent_red@15};   border-color: {accent_red@60}; }
QFrame#ReportBanner[action="spoof"] { background-color: {accent_cyan@15};  border-color: {accent_cyan@60}; }

QLabel#ReportBannerTitle {
    font-size: 14px;
    font-weight: 700;
}

QLabel#ReportBannerText {
    color: {text_secondary};
    font-size: 12px;
}

QLabel[role="action-pill"] {
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 700;
}

QLabel[role="action-pill"][action="keep"]   { background-color: {accent_green@18};  color: {accent_green}; }
QLabel[role="action-pill"][action="strip"]  { background-color: {accent_red@18};    color: {accent_red}; }
QLabel[role="action-pill"][action="spoof"]  { background-color: {accent_cyan@18};   color: {accent_cyan}; }
QLabel[role="action-pill"][action="custom"] { background-color: {accent_orange@18}; color: {accent_orange}; }

QLabel[role="danger-item"] {
    color: {accent_red};
    font-weight: 600;
    padding: 2px 0;
}

/* Face selection (AI Evasion) */
QFrame#FaceCard {
    background-color: {bg_medium};
    border: 1px solid {border_color};
    border-radius: 8px;
}

QLabel#FaceSelectionNote {
    color: {text_secondary};
    font-size: 12px;
}

/* Donate — brand colors are intentional */
QPushButton#btn_paypal, QPushButton#btn_coffee, QPushButton#btn_kofi, QPushButton#btn_github {
    border: none;
    font-size: 14px;
    font-weight: 700;
    padding: 8px;
}

QPushButton#btn_paypal { background-color: #0070ba; color: #ffffff; }
